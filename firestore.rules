rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }
    function immutableAdminFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'premium', 'tutorVerified', 'admin', 'suspended', 'banned']);
    }
    function safeText(value, max) { return value is string && value.size() <= max; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owner(uid) && request.resource.data.uid == uid;
      allow update: if signedIn() && (owner(uid) || admin());
      allow delete: if admin();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
      match /solutions/{solutionId} {
        allow read, create: if signedIn();
        allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      }
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || admin());
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /calls/{callId} {
      allow read, write: if signedIn();
      match /{allChildren=**} {
        allow read, write: if signedIn();
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      match /messages/{messageId} {
        allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if signedIn() && request.auth.uid == resource.data.senderId;
      }
      match /calls/{callId} {
        allow read, write: if signedIn();
        match /candidates/{candidateId} {
          allow read, write: if signedIn();
        }
      }
    }

    match /exchanges/{exchangeId} {
      allow read, write: if signedIn();
      match /tasks/{taskId} {
        allow read, write: if signedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read, create, update, delete: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn();
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.reviewerId == request.auth.uid && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if signedIn() && resource.data.reviewerId == request.auth.uid;
    }

    match /tutorApplications/{applicationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if admin();
    }
    match /tutors/{tutorId} { allow read: if signedIn(); allow write: if admin(); }
    match /subscriptions/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid || admin(); allow write: if false; }
    match /rewards/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.solutionUserId == request.auth.uid); }
    match /solutions/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /reports/{id} { allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid; allow read, update: if admin(); }
    match /blocks/{id} { allow read, create, delete: if signedIn() && (request.resource.data.blockerId == request.auth.uid || resource.data.blockerId == request.auth.uid); }
    match /products/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /carts/{uid} { allow read, write: if owner(uid); }
    match /orders/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if admin(); }
    match /supportTickets/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /announcements/{id} { allow read: if true; allow write: if admin(); }
    match /favorites/{id} { allow read, write: if signedIn() && request.auth.uid == request.resource.data.userId; }
    match /securityLogs/{id} { allow read: if admin(); allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if false; }
    match /adminLogs/{id} { allow read, write: if admin(); }
  }
}
