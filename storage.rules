rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }
    function image() { return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024; }
    function document() { return request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*') && request.resource.size < 10 * 1024 * 1024; }
    match /users/{uid}/profile/{fileName} { allow read: if true; allow write: if signedIn() && request.auth.uid == uid && image(); }
    match /users/{uid}/uploads/{fileName} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == uid && (image() || document()); }
    match /products/{productId}/{fileName} { allow read: if true; allow write: if admin() && image(); }
    match /chat/{conversationId}/{fileName} { allow read, write: if signedIn(); }
    match /{allPaths=**} { allow read: if true; allow write: if false; }
  }
}
